# Anthropic — still used by scorer, tailor, followup, and resume generator.
# Leave blank if you don't have credits; only job-description *parsing* has
# been migrated to Ollama.
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local LLM for job-description parsing) ───────────────────────────
# Ollama must be running on the host machine (not inside Docker).
# Install: curl -fsSL https://ollama.ai/install.sh | sh
# Pull:    ollama pull llama3.1:8b
#
# When the app runs in Docker, use host.docker.internal (not localhost).
# Requires extra_hosts: ["host.docker.internal:host-gateway"] in compose —
# already configured in docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_CONCURRENCY=2   # parallel parse requests (raise on faster CPUs)
# OLLAMA_TIMEOUT_S=120   # per-request timeout in seconds

# Notifications — set one or both; leave blank to disable
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
# Slack: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
